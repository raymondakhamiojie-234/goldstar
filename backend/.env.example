# Database connection string (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example local: postgresql://postgres:password@localhost:5432/goldstar?schema=public
# Example Supabase/Neon: postgresql://postgres.abcdefg:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/goldstar"

# JWT Secret for Admin Authentication (use a long random string in production)
JWT_SECRET="super-secret-goldstar-jwt-key"

# Server Port (default 5000)
PORT=5000
